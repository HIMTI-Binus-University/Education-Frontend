  "narrative": {
    "northStar": "HIMTI resource-first reference",
    "overview": "The user's pinned screenshot is the visual authority: HIMTI blue and navy, white panels, pale blue surroundings, and Plus Jakarta Sans. The generous search-led introduction gives way to denser academic cards, summary rows, and schedules. This records the built system, not a new visual direction.\n\nLight mode is intentional to match that reference and support studying. ENERGY 2 / RHYTHM 2 / MOTION 1: emphasis comes from typography and resource hierarchy, with hover/focus feedback rather than entrance animation.",
    "keyCharacteristics": [
      "Blue actions, navy headings, muted academic metadata.",
      "Rounded white panels, semantic icon tiles, and linked resource rows.",
      "Spacious discovery, denser reading and scheduling."
    ],
    "rules": [
      { "name": "The Academic Context Rule", "body": "Keep course, exam, period, and session metadata subordinate but legible; do not replace it with promotional badges.", "section": "colors" }
    ],
    "dos": [
      "Do preserve the approved light HIMTI reference, existing logo, and Plus Jakarta Sans commitment.",
      "Do keep demo academic content visibly labeled and show useful empty, loading, and error states.",
      "Do preserve keyboard focus, mobile 16px fields, and local reader overflow containment."
    ],
    "donts": [
      "Don't invent academic claims, identities, availability, or recording links to fill panels.",
      "Don't turn the provisional Markdown renderer into a promised Tiptap schema.",
      "Don't replace the resource hierarchy with decorative icons, a background grid, or entrance animation."
    ]
  }
